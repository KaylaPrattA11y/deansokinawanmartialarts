---
import Cards from "../cards/Cards.astro";
import Card from "../cards/Card.astro";
import Button from "../Button.astro";
import { type IKarateClass } from '../../constants';
import CalendarAddKarateClass from "../CalendarAddKarateClass.astro";
import { getCollection } from 'astro:content';
import { getVisibleClassYears, groupClassYearsByYear, type ClassYearEntry } from '../../utils/classYears';

const dayNameToNumber: Record<string, number> = {
  Sunday: 0, Monday: 1, Tuesday: 2, Wednesday: 3, Thursday: 4, Friday: 5, Saturday: 6,
};

const allAnnouncements = await getCollection('announcements');
const allClasses = await getCollection('classes');

const today = new Date();
today.setHours(0, 0, 0, 0);
// Best-effort year for the initial static render. Any display rules that must
// stay correct after publish (hiding past years, gating upcoming years) are
// re-checked client-side below against the visitor's real clock.
const buildYear = today.getFullYear();

function cancelledDatesFor(name: string): string[] {
  return allAnnouncements
    .filter((a) => a.data.className === name && a.data.cancelled && new Date(a.data.date) >= today)
    .map((a) => {
      const d = new Date(a.data.date);
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    });
}

function toKarateClass(entry: ClassYearEntry): IKarateClass {
  return {
    name: entry.name,
    ages: entry.ages,
    description: entry.description,
    startTime: entry.startTime,
    endTime: entry.endTime,
    location: entry.location,
    recurrence: entry.recurrence,
    recurrence_byDay: entry.recurrence_byDay.map(d => dayNameToNumber[d] ?? 0),
    tuitionOnce: entry.tuitionOnce,
    tuitionTwice: entry.tuitionTwice,
    tuition_billing_recurrence: entry.tuition_billing_recurrence,
  };
}

const visibleEntries = getVisibleClassYears(allClasses, buildYear);
const yearGroups = [...groupClassYearsByYear(visibleEntries).entries()];

const { headingLevel = 0, groupByYear = false } = Astro.props as {
  headingLevel?: number;
  groupByYear?: boolean;
};
const cardHeadingLevel = groupByYear ? Math.min(headingLevel + 1, 6) : headingLevel;
// In preview mode (e.g. homepage teaser) only the soonest year's classes are shown.
// Every group still renders (hidden) so a self-heal script can recover if the
// build-time year assumption goes stale before the site is republished.
const previewActiveYear = yearGroups[0]?.[0];
---

<div id="class-cards">
  {yearGroups.map(([year, entries]) => {
    const isActiveInPreview = year === previewActiveYear;
    return (
      <div
        class={`class-year-group${!groupByYear && !isActiveInPreview ? ' d-none' : ''}`}
        data-year-group={year}
        data-mode={groupByYear ? 'grouped' : 'preview'}
      >
        {groupByYear && (
          headingLevel === 1 ? <h1 class="class-year-heading">{year} Schedule:</h1> :
          headingLevel === 2 ? <h2 class="class-year-heading">{year} Schedule:</h2> :
          headingLevel === 3 ? <h3 class="class-year-heading">{year} Schedule:</h3> :
          headingLevel === 4 ? <h4 class="class-year-heading">{year} Schedule:</h4> :
          headingLevel === 5 ? <h5 class="class-year-heading">{year} Schedule:</h5> :
          headingLevel === 6 ? <h6 class="class-year-heading">{year} Schedule:</h6> :
          null
        )}
        <Cards cols={entries.length > 2 ? 3 : entries.length}>
          {entries.map((entry) => {
            const karateClass = toKarateClass(entry);
            const cancelledDates = cancelledDatesFor(entry.name);
            const isUpcoming = entry.year > buildYear;
            return (
              <Card kanji={entry.kanji}>
                <div class="class-entry" data-class-year={entry.year}>
                  <div class="class-age">Ages {karateClass.ages}</div>
                  <div class="class-entry-grid">
                    <div>
                      <CalendarAddKarateClass
                        id={`${entry.clsId}-${entry.year}-classes`}
                        karateClass={karateClass}
                        cancelledDates={cancelledDates}
                        headingLevel={cardHeadingLevel}
                        hideNextOccurrence={isUpcoming}
                      />
                      <p class="class-desc">{karateClass.description}</p>
                    </div>
                    <div>
                      <div class="class-tuition">{karateClass.tuition_billing_recurrence} Tuition:</div>
                      <ul>
                        <li>1 day per week: <strong>${karateClass.tuitionOnce}</strong></li>
                        {karateClass.tuitionTwice !== undefined && (<li>2 days per week: <strong>${karateClass.tuitionTwice}</strong></li>)}
                      </ul>
                    </div>
                  </div>
                  <div class={`class-cta${isUpcoming ? ' d-none' : ''}`} data-hide-if-upcoming>
                    <Button
                      type="button"
                      data-interest={karateClass.name}
                      aria-haspopup="dialog"
                      aria-controls="contact-dialog"
                    >
                      Join {karateClass.name}
                    </Button>
                  </div>
                </div>
              </Card>
            );
          })}
        </Cards>
      </div>
    );
  })}
</div>

<script>
  const classesSection = document.getElementById('class-cards') as HTMLElement | null;

  // Self-heal against a stale build: re-derive year-based display rules from
  // the visitor's real clock instead of trusting the build-time year forever.
  const trueYear = new Date().getFullYear();

  classesSection?.querySelectorAll<HTMLElement>('[data-year-group]').forEach(group => {
    const year = Number(group.dataset.yearGroup);
    if (year < trueYear) {
      group.remove();
    }
  });

  const previewGroups = classesSection
    ? [...classesSection.querySelectorAll<HTMLElement>('[data-year-group][data-mode="preview"]')]
      .sort((a, b) => Number(a.dataset.yearGroup) - Number(b.dataset.yearGroup))
    : [];
  previewGroups.forEach((group, index) => {
    group.classList.toggle('d-none', index !== 0);
  });

  classesSection?.querySelectorAll<HTMLElement>('[data-class-year]').forEach(card => {
    const isUpcoming = Number(card.dataset.classYear) > trueYear;
    card.querySelectorAll<HTMLElement>('[data-hide-if-upcoming]').forEach(el => {
      el.classList.toggle('d-none', isUpcoming);
    });
    card.querySelector('[data-component="CalendarAddKarateClass"]')?.classList.toggle('hide-next-class', isUpcoming);
  });

  classesSection?.addEventListener('click', event => {
    const isDialogTrigger = 
      event.target instanceof HTMLButtonElement 
      && event.target.hasAttribute('aria-haspopup') 
      && event.target.getAttribute('aria-haspopup') === 'dialog';
    if (isDialogTrigger) {
      const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;
      const form = document.forms.namedItem('contact-dialog-form') as HTMLFormElement | null;
      
      if (dialog && form) {
        const interest = form.elements.namedItem('interest') as HTMLSelectElement | null;
        const dataInterest = (event.target).getAttribute('data-interest') as string | null;
  
        form.reset();
        dialog.showModal();
        if (interest && dataInterest) {
          interest.value = dataInterest;
          interest.dispatchEvent(new Event('change', { bubbles: true }));
        }
        form.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
  });
</script>

<style>
  @layer components {
    .class-year-group:not(:last-child) {
      margin-block-end: 3rem;
    }
    .class-year-heading {
      font-family: var(--ff-heading);
      font-size: clamp(1.25rem, 3.5vw, 1.75rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--paper);
      margin-block: 0 1.5rem;
    }
    .class-entry {
      container: class-entry / inline-size;
      padding: 2rem 1.5rem;
    }
    .class-entry-grid {
      display: grid;
      gap: 0 2rem;
      @container class-entry (width >= 500px) {
        grid-template-columns: 1.75fr 1fr;
      }
    }
    .class-entry-grid :where(p,ul,h4) {
      margin-block: 1em;
    }
    .class-cta {
      display: grid;
      justify-content: center;
    }
    .class-age {
      font-family: var(--ff-heading);
      font-size: 0.9rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--silver);
      margin-bottom: 1rem;
    }
    .class-name {
      font-family: var(--ff-heading);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--paper);
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }
    .class-desc {
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--cream);
      margin-bottom: 1.5rem;
    }
    .class-schedule {
      font-family: var(--ff-heading);
      font-size: 0.9rem;
      letter-spacing: 0.2em;
      color: var(--glow-red);
      text-transform: uppercase;
      margin-block: 1em;
    }
    .class-tuition {
      font-family: var(--ff-body);
      font-size: 1rem;
      font-weight: 700;
      line-height: normal;
    }
    .class-entry ul {
      margin-inline-start: 1em;
    }
    ul {
      padding: 0;
      list-style: disc;
      line-height: normal;
    }
    li::marker {
      color: var(--deep-red);
    }
    .class-entry li {
      font-family: var(--ff-heading);
      font-size: 0.875rem;
    }
  }
</style>
